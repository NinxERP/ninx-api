# Copie para ".env" e preencha. Nunca commitar o ".env" real.

# Produção (Azure SQL) — valor padrão usado pelo serviço "api".
# Exemplo de shape: Server=tcp:<servidor>.database.windows.net,1433;Initial Catalog=<db>;User ID=<user>;Password=<senha>;Encrypt=True;TrustServerCertificate=False;
DB_CONNECTION_STRING=

# Para desenvolvimento local com banco em container (perfil "dev"):
# 1. Suba o banco: docker compose --profile dev up -d db
# 2. Troque DB_CONNECTION_STRING acima para:
#    Server=db,1433;Initial Catalog=ninx-db;User ID=sa;Password=${LOCAL_DB_PASSWORD};TrustServerCertificate=True;
#    (rodando `dotnet ef database update` do host em vez de dentro do container, use "Server=localhost,1433;..." no lugar de "Server=db,1433;...")
LOCAL_DB_PASSWORD=Ninx@Local123

JWT_SECRET=
JWT_ISSUER=NinxSGC
JWT_AUDIENCE=NinxSGCClient
JWT_EXPIRES_IN_MINUTES=1200

BREVO_API_KEY=
BREVO_SENDER_EMAIL=ninx.oficial@gmail.com
BREVO_SENDER_NAME=Ninx
